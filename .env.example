# Local-only by default. For a LAN test, set this to 0.0.0.0 and protect the host with a firewall.
IRLIGHT_BIND_ADDRESS=127.0.0.1
IRLIGHT_PUBLIC_HOST=localhost
IRLIGHT_UI_PORT=8080

IRLIGHT_WIDTH=1280
IRLIGHT_HEIGHT=720
IRLIGHT_FPS=30
IRLIGHT_VIDEO_BITRATE_KBPS=3500
IRLIGHT_RECOVERY_STABLE_SECONDS=3.0
IRLIGHT_INPUT_STALE_SECONDS=1.5
IRLIGHT_RESTART_DELAY_SECONDS=2.0
IRLIGHT_LOG_LEVEL=INFO

# Leave unset to publish to the local preview path.
# For an external test, put the complete RTMP/RTMPS destination here.
# Never commit the real stream key. This environment-variable transport is Phase 0 only.
# IRLIGHT_OUTPUT_URL=rtmps://example.invalid/app/REPLACE_WITH_STREAM_KEY
