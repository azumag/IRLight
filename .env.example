# 既定値はMediaMTX内のローカル出力です。
# Twitch等へ直接送る場合は、秘密情報をコミットせずローカル.envに設定してください。
EGRESS_URL=rtmp://mediamtx:1935/output/relay

# Phase 0 defaults
INPUT_URI=rtsp://mediamtx:8554/live/input
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=30
VIDEO_BITRATE_KBPS=3500
INPUT_TIMEOUT_SECONDS=1.5
RECOVERY_STABLE_SECONDS=3.0
SOURCE_RETRY_SECONDS=3.0

# メディアプロファイル: COMPOSITED_VIDEO_POC | AUDIO_PROCESSED | PASSTHROUGH
PROFILE=COMPOSITED_VIDEO_POC

# Node bootstrap / production compose (Phase B spike)
# NODE_CONTROL_PLANE_URL=http://control-plane:8080
# NODE_BOOTSTRAP_TOKEN=<one-time token; prefer NODE_BOOTSTRAP_TOKEN_FILE>
# NODE_BOOTSTRAP_TOKEN_FILE=/run/secrets/bootstrap_token
# NODE_EGRESS_URL=rtmp://mediamtx:1935/output/relay
# NODE_ABSOLUTE_DEADLINE_HOURS=12
# NODE_HEARTBEAT_INTERVAL=10
# NODE_SUPERVISOR=compose
# NODE_CONTINUITY_IMAGE=ghcr.io/azumag/irlight-continuity:phase-b-spike
# NODE_AGENT_IMAGE=ghcr.io/azumag/irlight-node-agent:phase-b-spike
# NODE_INGEST_AUTH_URL=http://control-plane:8080/internal/ingest/auth
# NODE_RTMPS_KEY_FILE=/etc/irlight/tls/ingest.example.com.key
# NODE_RTMPS_CERT_FILE=/etc/irlight/tls/ingest.example.com.fullchain.pem

# Hard ingest policy: REJECTEDはMediaMTXからpublisherをkickする。
# NODE_INGEST_POLICY_ENABLED=1
# NODE_MEDIAMTX_API_URL=http://mediamtx:9997
# NODE_INGEST_PATH=live/input
# NODE_INGEST_MAX_BITRATE_BPS=6000000
# NODE_INGEST_BITRATE_VIOLATION_SAMPLES=2

# Live quality policy: DEGRADEDはkickせず配信を継続しながら警告・event化する。
# Node Agent内のffprobeがinternal RTSP pathを短時間sampleする。
# NODE_INGEST_QUALITY_ENABLED=1
# NODE_INGEST_SAMPLE_URL=rtsp://mediamtx:8554/live/input
# NODE_INGEST_SAMPLE_SECONDS=4
# NODE_INGEST_MIN_FPS=20
# NODE_INGEST_PREFERRED_MIN_FPS=24
# NODE_INGEST_PREFERRED_MAX_FPS=35
# NODE_INGEST_MAX_FPS=40
# NODE_INGEST_MAX_GOP_SECONDS=4
# sample windowの何割以上timestampが進行していればhealthyとみなすか。
# NODE_INGEST_MIN_PROGRESS_RATIO=0.60
# NODE_INGEST_MIN_BITRATE_BPS=500000
# NODE_INGEST_LOW_BITRATE_SAMPLES=2
# NODE_FFPROBE_PATH=ffprobe

# Control Plane (Phase B spike)
# STATE_DIR=/state
# NODE_STATE_DIR=/state
# NODE_BOOTSTRAP_TOKENS=<comma-separated one-time tokens>
# NODE_EGRESS_URL=rtmp://mediamtx:1935/output/relay
# IRLIGHT_INGEST_PUBLIC_HOST=ingest.example.com
# IRLIGHT_INGEST_RTMP_PORT=1935
# IRLIGHT_INGEST_RTMPS_ENABLED=1
# IRLIGHT_INGEST_RTMPS_PORT=1936
# IRLIGHT_INGEST_SRT_PORT=8890
